# MGTS Infrastructure Intelligence — пример конфигурации окружения.
# Скопируйте в .env: cp .env.example .env
# Файл .env НЕ коммитится (см. .gitignore).
#
# Полный список настроек: backend/app/config.py (pydantic-settings, env).
# Значения ниже = дефолты для локальной разработки. В production
# (APP_ENV=production) действует строгий валидатор секретов — см. комментарии
# у JWT_SECRET_KEY / BOOTSTRAP_ADMIN_PASSWORD / S3_* / QUEUE_MODE / CORS_ORIGINS
# и docs/operations/deployment.md.

# --- Приложение ---
APP_ENV=development
APP_NAME=mgts-infra
APP_VERSION=0.1.0
# DEBUG — флаг debug FastAPI: при ошибках в ответах отдаются traceback'и.
# Только для локальной разработки; в production обязан быть false.
DEBUG=false
API_V1_PREFIX=/api/v1

# --- База данных (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+asyncpg://mgts:mgts@localhost:5432/mgts_infra
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Логировать все SQL-запросы (шумно; только для отладки).
DATABASE_ECHO=false

# --- Redis / очередь RQ ---
REDIS_URL=redis://localhost:6379/0
# rq | inline. inline выполняет pipeline в процессе API — только для тестов/dev.
# ВНИМАНИЕ: QUEUE_MODE=inline в production ЗАПРЕЩЁН (валидатор не даст стартовать).
QUEUE_MODE=rq
RQ_QUEUE_NAME=processing
RQ_JOB_TIMEOUT=1800
RQ_RESULT_TTL=86400
RQ_RETRY_MAX=3

# --- Хранилище файлов: s3 | local ---
# s3 = любой S3-совместимый сервер (в compose — SeaweedFS; MinIO совместим, см. ADR-0006)
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=./var/storage
# Internal endpoint для операций backend'а (в compose — http://s3:9000).
S3_ENDPOINT_URL=http://localhost:9000
# Публичный endpoint для presigned-ссылок, которые открывает браузер.
# SigV4 подписывает Host, поэтому internal Docker-hostname (http://s3:9000)
# в ссылке недостижим из браузера и не может быть переписан на клиенте.
# Пусто = presign через S3_ENDPOINT_URL (годится, только если он публично доступен).
# В compose dev задайте http://localhost:9000; в production — публичный URL
# S3/reverse proxy. См. docs/integrations/storage.md.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# dev-заглушки (историческое имя). В production значения minioadmin
# ОТКЛОНЯЮТСЯ валидатором — задайте реальные ключи S3-сервера.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mgts-infra
S3_REGION=us-east-1
# TTL presigned-ссылок (только GET), секунды.
S3_PRESIGN_EXPIRES_SECONDS=3600

# --- ML-провайдер: mock | http ---
ML_PROVIDER=mock
ML_HTTP_BASE_URL=http://localhost:8001
ML_HTTP_TIMEOUT_SECONDS=30
# Ретраи только timeout/connect/5xx; 4xx не повторяются.
ML_HTTP_RETRIES=2
ML_HTTP_BACKOFF_SECONDS=0.5
ML_CONTRACT_VERSION=1.0

# --- Аутентификация ---
# JWT_SECRET_KEY ОБЯЗАТЕЛЕН в production: пустое значение, известные
# placeholder'ы (change-me*, changeme, secret) и длина < 32 символов → отказ старта.
# Сгенерируйте: openssl rand -hex 32
# В dev допустимо оставить ПУСТЫМ — будет использован случайный эфемерный ключ
# (сессии не переживают рестарт). При нескольких инстансах API (реплики,
# API + worker вне compose) ключ ОБЯЗАТЕЛЬНО задать явно и одинаково во всех
# процессах, иначе токены одного инстанса не проходят проверку другого.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Администратор создаётся при первом старте, если пользователей ещё нет
# и пароль задан. В production: пустое значение (bootstrap пропускается)
# либо сильный пароль >= 12 символов; placeholder'ы отклоняются валидатором.
# После первого старта смените пароль и уберите переменную из окружения.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- HTTP ---
# Только явные origin'ы: '*' ЗАПРЕЩЁН (credentials-режим CORS), валидатор
# отклоняет wildcard в любом окружении.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Лимит multipart-загрузки (байты). Согласуйте с client_max_body_size proxy.
MAX_UPLOAD_SIZE_BYTES=2147483648
# Лимит JSON-тела запроса (байты); проверяется middleware до auth → 413.
MAX_JSON_BODY_BYTES=2097152

# --- Rate limiting (Redis sliding window; 429 + Retry-After) ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Защита от перебора конкретного аккаунта с разных IP (ботнет).
RATE_LIMIT_LOGIN_PER_USERNAME_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30

# --- Обработка (pipeline) ---
PROCESSING_FRAME_INTERVAL_SECONDS=1.0
PROCESSING_MAX_FRAMES=2000
# Защита от memory bomb: probe размерности ДО decode; больше лимита → кадр отклоняется.
PROCESSING_MAX_IMAGE_PIXELS=64000000
# Кадр для обработки уменьшается до longest side <= этого значения;
# оригинал в хранилище не изменяется, bbox — в пикселях сохранённого кадра.
PROCESSING_MAX_FRAME_SIDE=4096
# Жёсткий предел стороны: больше — отклонение до decode.
PROCESSING_HARD_MAX_FRAME_SIDE=8192

# --- Quality gate ---
QUALITY_GATE_ENABLED=true
QUALITY_BLUR_THRESHOLD=60.0
QUALITY_MIN_WIDTH=320
QUALITY_MIN_HEIGHT=240
QUALITY_OVEREXPOSURE_MEAN=245.0
QUALITY_UNDEREXPOSURE_MEAN=10.0

# --- Дедупликация (см. ADR-0005) ---
DEDUP_RADIUS_M=15.0
DEDUP_MATCH_THRESHOLD=0.70
DEDUP_POSSIBLE_THRESHOLD=0.45
DEDUP_TIME_WINDOW_HOURS=2.0
# Максимум кандидатов в радиусе (ближайшие сверху); в плотной зоне
# маленький лимит может пропустить true match.
DEDUP_MAX_CANDIDATES=50

# --- GPS ---
# accuracy_m хуже порога → статус ESTIMATED вместо CONFIRMED (GEO-3);
# отсутствие accuracy_m в метаданных сохраняет прежнее поведение.
GPS_MAX_ACCURACY_M=50.0

# --- Надёжность / worker ---
# Stale-sweeper: PROCESSING/QUEUED без живого RQ-исполнения и с
# updated_at старше rq_job_timeout + это значение → FAILED (stale_*).
STALE_JOB_GRACE_SECONDS=120
# Prometheus-метрики worker'а (start_http_server в процессе воркера).
WORKER_METRICS_PORT=9100

# --- Risk scoring (см. ADR-0007; проектная эвристика, не стандарт) ---
RISK_POLICY_VERSION=1.0
RISK_HIGH_THRESHOLD=70.0
RISK_MEDIUM_THRESHOLD=40.0
RISK_REVIEW_CONFIDENCE_THRESHOLD=0.6

# --- Наблюдаемость ---
LOG_LEVEL=INFO
# json | console (для локальной разработки удобнее console)
LOG_FORMAT=console
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=mgts-infra-backend

# --- Аналитика / демо-область ---
# min_lon,min_lat,max_lon,max_lat (порядок координат: longitude, latitude)
DEMO_AREA_BBOX=37.55,55.70,37.70,55.80
COVERAGE_GRID_CELL_M=250.0

# --- Allowlists загрузок (расширение ↔ MIME ↔ magic bytes) ---
ALLOWED_IMAGE_MIME_TYPES=["image/jpeg","image/png","image/webp"]
ALLOWED_VIDEO_MIME_TYPES=["video/mp4","video/x-msvideo","video/quicktime","video/webm"]
ALLOWED_IMAGE_EXTENSIONS=[".jpg",".jpeg",".png",".webp"]
ALLOWED_VIDEO_EXTENSIONS=[".mp4",".avi",".mov",".webm"]
