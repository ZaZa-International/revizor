# MGTS Infrastructure Intelligence — пример конфигурации окружения.
# Скопируйте в .env: cp .env.example .env
# Файл .env НЕ коммитится (см. .gitignore).

# --- Приложение ---
APP_ENV=development
DEBUG=false

# --- База данных (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+asyncpg://mgts:mgts@localhost:5432/mgts_infra
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis / очередь RQ ---
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=processing
RQ_JOB_TIMEOUT=1800

# --- Хранилище файлов: s3 | local ---
# s3 = любой S3-совместимый сервер (в compose — SeaweedFS; MinIO совместим, см. ADR-0006)
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=./var/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mgts-infra
S3_REGION=us-east-1

# --- ML-провайдер: mock | http ---
ML_PROVIDER=mock
ML_HTTP_BASE_URL=http://localhost:8001
ML_HTTP_TIMEOUT_SECONDS=30

# --- Аутентификация ---
# JWT_SECRET_KEY ОБЯЗАТЕЛЕН в production (APP_ENV=production) — без него приложение не стартует.
# Сгенерируйте: openssl rand -hex 32
# В dev допустимо оставить пустым — будет использован случайный ключ (сессии не переживают рестарт).
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Администратор создаётся при первом старте, если пользователей ещё нет.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# --- HTTP ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_UPLOAD_SIZE_BYTES=2147483648

# --- Наблюдаемость ---
LOG_LEVEL=INFO
# json | console (для локальной разработки удобнее console)
LOG_FORMAT=console
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
