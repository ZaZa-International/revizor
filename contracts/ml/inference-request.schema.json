{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://mgts-infra.local/contracts/ml/inference-request.schema.json", "title": "MLInferenceRequest", "description": "Single-image inference request (contract schema_version 1.0). Derived from backend/app/schemas/ml.py. bbox coordinates are absolute pixels of the source image, origin top-left. Geographic coordinates are (longitude, latitude), WGS84.", "type": "object", "additionalProperties": false, "required": ["schema_version", "request_id", "image"], "properties": {"schema_version": {"const": "1.0"}, "request_id": {"$ref": "#/$defs/uuid"}, "image": {"$ref": "#/$defs/MLImageRef"}, "metadata": {"$ref": "#/$defs/MLFrameMetadata"}}, "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"}, "MLImageRef": {"type": "object", "additionalProperties": false, "required": ["storage_key", "width", "height"], "properties": {"storage_key": {"type": "string", "minLength": 1, "maxLength": 1024}, "width": {"type": "integer", "exclusiveMinimum": 0, "maximum": 32768}, "height": {"type": "integer", "exclusiveMinimum": 0, "maximum": 32768}, "checksum_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}, "MLFrameMetadata": {"type": "object", "additionalProperties": false, "properties": {"observed_at": {"type": ["string", "null"], "format": "date-time"}, "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180}, "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90}, "heading_deg": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360}, "speed_mps": {"type": ["number", "null"], "minimum": 0}, "route_id": {"type": ["string", "null"]}, "frame_index": {"type": ["integer", "null"], "minimum": 0}, "tracking_id": {"type": ["string", "null"]}}, "allOf": [{"if": {"properties": {"longitude": {"type": "number"}}, "required": ["longitude"]}, "then": {"properties": {"latitude": {"type": "number"}}, "required": ["latitude"]}}, {"if": {"properties": {"latitude": {"type": "number"}}, "required": ["latitude"]}, "then": {"properties": {"longitude": {"type": "number"}}, "required": ["longitude"]}}]}}}