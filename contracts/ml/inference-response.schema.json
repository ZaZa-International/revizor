{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://mgts-infra.local/contracts/ml/inference-response.schema.json", "title": "MLInferenceResponse", "description": "Single-image inference response (contract schema_version 1.0). Derived from backend/app/schemas/ml.py. An empty detections array is a valid result, not an error. detection_id must be unique within a response (enforced by the backend Pydantic model; uniqueItems rejects fully identical items).", "type": "object", "additionalProperties": false, "required": ["schema_version", "request_id", "model", "detections"], "properties": {"schema_version": {"const": "1.0"}, "request_id": {"$ref": "#/$defs/uuid"}, "model": {"$ref": "#/$defs/MLModelInfo"}, "detections": {"type": "array", "items": {"$ref": "#/$defs/MLDetection"}, "uniqueItems": true}, "inference_time_ms": {"type": ["number", "null"], "minimum": 0}}, "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"}, "MLModelInfo": {"type": "object", "additionalProperties": false, "required": ["name", "version", "schema_version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "schema_version": {"type": "string", "default": "1.0"}}}, "MLBBox": {"type": "object", "description": "Absolute pixel coordinates, origin top-left. Backend additionally enforces x_min < x_max and y_min < y_max (not expressible in JSON Schema).", "additionalProperties": false, "required": ["x_min", "y_min", "x_max", "y_max"], "properties": {"x_min": {"type": "number", "minimum": 0}, "y_min": {"type": "number", "minimum": 0}, "x_max": {"type": "number", "exclusiveMinimum": 0}, "y_max": {"type": "number", "exclusiveMinimum": 0}}}, "MLDetection": {"type": "object", "additionalProperties": false, "required": ["detection_id", "object_type", "confidence", "bbox"], "properties": {"detection_id": {"$ref": "#/$defs/uuid"}, "object_type": {"type": "string", "minLength": 1, "maxLength": 64}, "condition_class": {"type": ["string", "null"], "maxLength": 64}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "severity": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}, "bbox": {"$ref": "#/$defs/MLBBox"}, "embedding": {"type": ["array", "null"], "items": {"type": "number"}}, "attributes": {"type": "object"}}}}}