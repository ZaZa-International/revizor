{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://mgts-infra.local/contracts/ml/batch-response.schema.json", "title": "MLBatchResponse", "description": "Batch inference response (contract schema_version 1.0). Derived from backend/app/schemas/ml.py. Partial failures are expressed per item: OK items must carry a response, ERROR items must carry an error. Item request_id must match one of the batch request ids (checked by the backend).", "type": "object", "additionalProperties": false, "required": ["schema_version", "model", "results"], "properties": {"schema_version": {"const": "1.0"}, "model": {"$ref": "model-info.schema.json"}, "results": {"type": "array", "items": {"$ref": "#/$defs/MLBatchItemResult"}}}, "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"}, "MLItemError": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}, "MLBatchItemResult": {"type": "object", "additionalProperties": false, "required": ["request_id", "status"], "properties": {"request_id": {"$ref": "#/$defs/uuid"}, "status": {"enum": ["OK", "ERROR"]}, "response": {"oneOf": [{"$ref": "inference-response.schema.json"}, {"type": "null"}]}, "error": {"oneOf": [{"$ref": "#/$defs/MLItemError"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"status": {"const": "OK"}}, "required": ["status"]}, "then": {"required": ["response"], "properties": {"response": {"type": "object"}}}}, {"if": {"properties": {"status": {"const": "ERROR"}}, "required": ["status"]}, "then": {"required": ["error"], "properties": {"error": {"type": "object"}}}}]}}}